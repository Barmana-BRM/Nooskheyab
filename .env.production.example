NODE_ENV=production
APP_ENV=production
PORT=4000
WEB_APP_URL=https://app.example.com
API_PUBLIC_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=pharmacy_mvp
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=replace-with-a-generated-secret
DATABASE_URL=postgresql://pharmacy:replace-with-a-generated-secret@postgres:5432/pharmacy_mvp
REDIS_PASSWORD=replace-with-a-generated-secret
REDIS_URL=redis://:replace-with-a-generated-secret@redis:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_EXPIRES_IN=7d

PRESCRIPTION_EXPIRATION_HOURS=6
PRESCRIPTION_CREATE_RATE_LIMIT=5
PRESCRIPTION_CREATE_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900

MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=pharmacy-documents
S3_ACCESS_KEY=replace-with-a-minio-user
S3_SECRET_KEY=replace-with-a-minio-password
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880
PHARMACY_DOCUMENT_TECHNICAL_MANAGER_REQUIRED=false

ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_MOBILE=
SWAGGER_ENABLED=false
LOG_LEVEL=info
VITE_APP_NAME=نسخه‌یاب
VITE_ALLOWED_EXTERNAL_HOSTS=storage.example.com
