{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@pharmacy-mvp/types": ["packages/types/src/index.ts"],
      "@pharmacy-mvp/validation": ["packages/validation/src/index.ts"],
      "@pharmacy-mvp/config": ["packages/config/src/index.ts"],
      "@pharmacy-mvp/api-client": ["packages/api-client/src/index.ts"]
    },
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
