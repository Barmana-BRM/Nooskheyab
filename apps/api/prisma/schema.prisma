generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PHARMACY_ADMIN
  PHARMACY_USER
}

enum RegistrationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
}

enum DocumentType {
  PHARMACY_LICENSE
  TECHNICAL_MANAGER_CARD
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrescriptionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  PARTIAL
  REJECTED
  SELECTED_PHARMACY
  EXPIRED
  COMPLETED
  CANCELLED
}

enum PrescriptionRequestStatus {
  SENT
  VIEWED
  RESPONDED
  SELECTED
  CLOSED
  EXPIRED
}

enum AvailabilityStatus {
  FULL_AVAILABLE
  PARTIAL_AVAILABLE
  NOT_AVAILABLE
}

enum InsuranceType {
  BASE
  SUPPLEMENTARY
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
  REACTIVATED
}

enum NotificationType {
  NEW_PRESCRIPTION
  PHARMACY_REVIEW
  SYSTEM
}

model User {
  id                String                  @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  username          String                  @unique
  email             String?                 @unique
  mobile            String                  @unique
  passwordHash      String
  role              UserRole
  pharmacyId        String?                 @db.Uuid
  isActive          Boolean                 @default(true)
  lastLoginAt       DateTime?
  failedLoginCount  Int                     @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  pharmacy          Pharmacy?               @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  refreshSessions   RefreshSession[]
  auditLogs         AuditLog[]
  uploadedDocuments PharmacyDocument[]      @relation("UploadedDocuments")
  responses         PharmacyResponse[]
  reviewHistory     PharmacyReviewHistory[]
  notifications     Notification[]

  @@index([role, isActive])
  @@index([pharmacyId, isActive])
}

model Pharmacy {
  id                         String                        @id @default(uuid()) @db.Uuid
  name                       String
  technicalManager           String
  technicalManagerIdentifier String?
  pharmacyIdentifier         String?                       @unique
  licenseNumber              String                        @unique
  licenseExpirationDate      DateTime
  mobile                     String
  phone                      String
  province                   String
  city                       String
  address                    String
  postalCode                 String
  latitude                   Decimal?                      @db.Decimal(10, 7)
  longitude                  Decimal?                      @db.Decimal(10, 7)
  workingHours               String
  registrationStatus         RegistrationStatus            @default(DRAFT)
  reviewMessage              String?
  approvedBy                 String?                       @db.Uuid
  approvedAt                 DateTime?
  isActive                   Boolean                       @default(true)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  deletedAt                  DateTime?
  users                      User[]
  documents                  PharmacyDocument[]
  assignments                PrescriptionPharmacyRequest[]
  responses                  PharmacyResponse[]
  selectedPrescriptions      Prescription[]                @relation("SelectedPharmacy")
  reviewHistory              PharmacyReviewHistory[]
  notifications              Notification[]

  @@index([registrationStatus, isActive])
  @@index([createdAt])
}

model PharmacyDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  pharmacyId         String                     @db.Uuid
  documentType       DocumentType
  storageKey         String
  originalName       String
  mimeType           String
  fileSize           Int
  sha256             String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedBy         String                     @db.Uuid
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  pharmacy           Pharmacy                   @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  uploader           User                       @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([pharmacyId, documentType])
  @@index([verificationStatus])
}

model Prescription {
  id                        String                        @id @default(uuid()) @db.Uuid
  publicId                  String                        @unique
  accessTokenHash           String                        @unique
  mobile                    String
  nationalId                String
  prescriptionTrackingCode  String
  baseInsuranceId           String                        @db.Uuid
  hasSupplementaryInsurance Boolean                       @default(false)
  supplementaryInsuranceId  String?                       @db.Uuid
  supplementaryDescription  String?
  patientDescription        String?
  status                    PrescriptionStatus            @default(PENDING)
  selectedPharmacyId        String?                       @db.Uuid
  expiresAt                 DateTime
  completedAt               DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  baseInsurance             InsuranceProvider             @relation("BaseInsurance", fields: [baseInsuranceId], references: [id], onDelete: Restrict)
  supplementaryInsurance    InsuranceProvider?            @relation("SupplementaryInsurance", fields: [supplementaryInsuranceId], references: [id], onDelete: Restrict)
  selectedPharmacy          Pharmacy?                     @relation("SelectedPharmacy", fields: [selectedPharmacyId], references: [id], onDelete: Restrict)
  assignments               PrescriptionPharmacyRequest[]
  responses                 PharmacyResponse[]

  @@index([prescriptionTrackingCode])
  @@index([nationalId])
  @@index([mobile])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([selectedPharmacyId])
}

model PrescriptionPharmacyRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  prescriptionId String                    @db.Uuid
  pharmacyId     String                    @db.Uuid
  status         PrescriptionRequestStatus @default(SENT)
  sentAt         DateTime                  @default(now())
  seenAt         DateTime?
  respondedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  prescription   Prescription              @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  pharmacy       Pharmacy                  @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, pharmacyId])
  @@index([pharmacyId, status, sentAt])
  @@index([prescriptionId, pharmacyId])
}

model PharmacyResponse {
  id                 String             @id @default(uuid()) @db.Uuid
  prescriptionId     String             @db.Uuid
  pharmacyId         String             @db.Uuid
  userId             String             @db.Uuid
  availabilityStatus AvailabilityStatus
  description        String?
  respondedAt        DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  prescription       Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  pharmacy           Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, pharmacyId])
  @@index([prescriptionId, pharmacyId])
}

model InsuranceProvider {
  id                         String         @id @default(uuid()) @db.Uuid
  name                       String
  type                       InsuranceType
  isActive                   Boolean        @default(true)
  sortOrder                  Int            @default(0)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  basePrescriptions          Prescription[] @relation("BaseInsurance")
  supplementaryPrescriptions Prescription[] @relation("SupplementaryInsurance")

  @@unique([name, type])
  @@index([type, isActive, sortOrder])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  entityType   String
  entityId     String?  @db.Uuid
  requestId    String
  ipAddress    String
  userAgent    String
  metadataJson Json
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([requestId])
}

model RefreshSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  deviceId         String?
  platform         String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @db.Uuid
  pharmacyId String?          @db.Uuid
  type       NotificationType
  entityId   String?          @db.Uuid
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
}

model PharmacyReviewHistory {
  id          String       @id @default(uuid()) @db.Uuid
  pharmacyId  String       @db.Uuid
  action      ReviewAction
  message     String?
  adminUserId String       @db.Uuid
  createdAt   DateTime     @default(now())
  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  admin       User         @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([pharmacyId, createdAt])
}
